<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <!-- Every package is pinned with its fingerprint, and CI refuses any other. GitHub sets CI. -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RestoreLockedMode Condition="'$(CI)' == 'true'">true</RestoreLockedMode>
    <NuGetAuditMode>all</NuGetAuditMode>
    <!-- The places where a process kills itself exist only in test builds. -->
    <DefineConstants Condition="'$(Faults)' == 'true'">$(DefineConstants);FAULTS</DefineConstants>
  </PropertyGroup>
</Project>
